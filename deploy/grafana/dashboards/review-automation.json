{
  "uid": "review-automation",
  "title": "Review Automation",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    { "id": 1, "type": "stat", "title": "Reviews received (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(increase(reviews_received_total[1h]))" } ] },
    { "id": 2, "type": "stat", "title": "Jobs failed (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(increase(jobs_finished_total{status=\"failed\"}[1h]))" } ] },
    { "id": 3, "type": "stat", "title": "Guardrail blocks (1h)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(increase(guardrail_blocks_total[1h]))" } ] },
    { "id": 4, "type": "stat", "title": "Targets up (expect 2+)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0" }, "overrides": [] },
      "targets": [ { "refId": "A", "expr": "sum(up)" } ] },
    { "id": 5, "type": "timeseries", "title": "Jobs by outcome (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{status}}", "expr": "sum by (status) (increase(jobs_finished_total[5m]))" } ] },
    { "id": 6, "type": "timeseries", "title": "LLM p95 latency (seconds)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{node}}", "expr": "histogram_quantile(0.95, sum by (le, node) (rate(llm_request_seconds_bucket[5m])))" } ] },
    { "id": 7, "type": "timeseries", "title": "Guardrail blocks by reason (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{stage}}: {{reason}}", "expr": "sum by (stage, reason) (increase(guardrail_blocks_total[5m]))" } ] },
    { "id": 8, "type": "timeseries", "title": "LLM tokens (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{type}}", "expr": "sum by (type) (increase(llm_tokens_total[5m]))" } ] },
    { "id": 9, "type": "timeseries", "title": "HubSpot / WhatsApp calls by outcome (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{service}}: {{outcome}}", "expr": "sum by (service, outcome) (increase(external_requests_total[5m]))" } ] },
    { "id": 10, "type": "timeseries", "title": "API requests by route (5m)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "refId": "A", "legendFormat": "{{route}} {{status}}", "expr": "sum by (route, status) (increase(http_requests_total[5m]))" } ] }
  ]
}